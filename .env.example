# Copie para .env e troque os valores. Nunca versione o .env.

POSTGRES_USER=octaedu
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=octaedu

# Local: localhost:5440 (porta do banco publicada pelo docker compose). No compose, o app usa o host "db".
DATABASE_URL=postgresql://octaedu:troque-esta-senha@localhost:5440/octaedu?schema=public

# Pasta onde os arquivos enviados ficam salvos.
UPLOAD_DIR=./uploads

# Mostra os botões de conta de demonstração na tela de login. Use false em produção.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# Porta do app no docker compose.
APP_PORT=3000

# Cookie de sessão só via HTTPS em produção. Use false apenas em teste sem HTTPS.
COOKIE_SECURE=true
